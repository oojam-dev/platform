# oojam production configuration. Copy to deploy/.env (bin/bootstrap does it
# and fills in every password/secret marked "generated"), then fill in the rest.
#
# - compose.yml reads this file for interpolation only; each service receives
#   only the variables listed for it there.
# - Values are taken literally: no quotes, no spaces around `=`, no `$`.
# - Keep a copy of the finished file somewhere safe (a password manager):
#   the database passwords are needed to restore backups elsewhere.
# - The database URLs the services get are assembled in compose.yml from the
#   passwords below (one place per secret):
#     DATABASE_URL          postgres://platform_app:${PLATFORM_APP_PASSWORD}@postgres:5432/platform   (web, worker)
#     SITE_DB_MIGRATOR_URL  postgres://site_migrator:${SITE_MIGRATOR_PASSWORD}@postgres:5432/site      (worker → deploy migrations)
#     SITE_DB_APP_URL       postgres://site_app:${SITE_APP_PASSWORD}@postgres:5432/site                (worker → site containers)
#     PLATFORM_MIGRATE_URL  postgres://platform_owner:${PLATFORM_OWNER_PASSWORD}@postgres:5432/platform (bin/platform-migrate only)
#   so passwords must be URL-safe: A-Z a-z 0-9 . _ ~ - (bin/bootstrap uses hex).

# ── Domains and TLS ─────────────────────────────────────────────────────────
SITE_DOMAIN=oojam.dev
PLATFORM_DOMAIN=build.oojam.dev
# Let's Encrypt account / expiry notices.
ACME_EMAIL=
# Derived from the domains when empty.
PLATFORM_URL=https://build.oojam.dev
SITE_URL=https://oojam.dev

# ── Images ──────────────────────────────────────────────────────────────────
# Tag compose builds the platform image under (platform-web, worker, gateway).
PLATFORM_IMAGE=oojam-platform:latest
# Builder image the worker runs (bin/update-platform builds it).
BUILDER_IMAGE=oojam-builder:latest

# ── Database passwords (generated) ──────────────────────────────────────────
# Used by postgres/initdb/01-init.sh on the FIRST boot only. Changing one later
# needs an ALTER ROLE as well: README › Rotating secrets.
POSTGRES_PASSWORD=
PLATFORM_OWNER_PASSWORD=
PLATFORM_APP_PASSWORD=
SITE_MIGRATOR_PASSWORD=
SITE_APP_PASSWORD=
BACKUP_DB_PASSWORD=

# ── platform-web ────────────────────────────────────────────────────────────
# Signs sessions, OAuth state and CSRF tokens (generated).
SESSION_SECRET=
# GitHub OAuth app (README › GitHub OAuth app). Callback:
# https://build.oojam.dev/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Generated by bin/bootstrap: signs "Sign in with oojam" tokens. Its public half is committed in
# oojam-dev/oojam at app/lib/oojam-identity.server.ts (print it with bin/identity-pubkey).
OOJAM_IDENTITY_PRIVATE_KEY=
# Comma-separated GitHub logins that are admins (/admin).
ADMIN_GITHUB_LOGINS=
MIN_GITHUB_ACCOUNT_AGE_DAYS=30
SCREEN_MODEL=claude-opus-5-5

# ── Anthropic (web: screening; worker: review; gateway: builds) ─────────────
# Use a key from a workspace with a monthly spend limit (README › Anthropic).
ANTHROPIC_API_KEY=

# ── worker ──────────────────────────────────────────────────────────────────
# GitHub App (README › GitHub App). The private key is NOT in this file: save
# it as deploy/secrets/github-app.pem (mounted at /run/secrets/github-app.pem,
# GITHUB_APP_PRIVATE_KEY_FILE in the container).
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
SITE_REPO=oojam-dev/oojam
# Optional: clone URL override (default https://github.com/$SITE_REPO.git).
SITE_REPO_URL=
# Worker ↔ gateway admin API (generated).
GATEWAY_URL=http://gateway:8787
GATEWAY_ADMIN_TOKEN=
BUILD_MODEL=claude-opus-5-5
BUILD_EFFORT=high
REVIEW_MODEL=claude-opus-5-5
BUILD_TIMEOUT_MIN=60
DEP_MIN_AGE_DAYS=14
# 00:00 UTC daily.
CYCLE_CRON=0 0 * * *
# true: everything runs except push, PR, merge and deploy. Start with true;
# set false once a dry-run cycle has looked right (README › First cycle).
DRY_RUN=true

# ── Votes and builds (core: web and worker) ─────────────────────────────────
MAX_IDEAS_PER_DAY=1
SPONSOR_URL=https://github.com/sponsors/oojam-dev
# The most oojam spends on Claude per UTC day (build + review + screening).
DAILY_BUDGET_USD=10
BUILD_BUDGET_MIN_USD=3

# ── Backups ─────────────────────────────────────────────────────────────────
# Nightly at BACKUP_TIME (UTC) into /opt/oojam/data/backups, newest
# BACKUP_KEEP_DAYS kept. Off-box copy when all four BACKUP_S3_* below are set
# (Hetzner Object Storage: endpoint https://<location>.your-objectstorage.com,
# e.g. https://fsn1.your-objectstorage.com).
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=oojam
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# Optional: encrypt the off-box copies (rclone crypt). Keep it with this file:
# without it the off-box copies can't be read.
BACKUP_ENCRYPTION_PASSWORD=
